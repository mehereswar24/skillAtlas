# Copy to deploy/.env and fill in. Every value marked REQUIRED has no default
# and the stack refuses to start without it — that is deliberate, because each
# one is a setting whose development default is unsafe on the internet.
#
#   cp deploy/.env.production.example deploy/.env
#   docker compose -f deploy/compose.prod.yml --env-file deploy/.env up -d --build

# --- REQUIRED: signing key for access and refresh tokens -------------------
# Generate a fresh one. Anyone who knows this value can mint a token for any
# account, so it must never be committed, reused between environments, or
# copied from this file.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- REQUIRED: database password -------------------------------------------
# Postgres is not published to the host, so this guards the compose network
# rather than the internet. Still generate it rather than typing one.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_USER=skillatlas
POSTGRES_DB=skillatlas

# --- REQUIRED: where the app is served from --------------------------------
# JSON array. Must be https:// in production — cookies are marked Secure and
# a browser will not send them over plaintext, so a http:// origin here means
# nobody can stay logged in. The API refuses to start if you try.
CORS_ORIGINS=["https://skillatlas.example.com"]

# --- ports ------------------------------------------------------------------
# The host port the BFF is published on. Point your TLS terminator here.
WEB_PORT=3000

# --- content ----------------------------------------------------------------
# Load the seed corpus on boot. Wanted exactly once, on a first deploy or after
# a content change; it rewrites every concept and takes minutes, so leave it
# off for routine restarts.
SEED_ON_START=false

# Serve only the fully-written tracks and hide the outline ones. Off by default,
# so all 92 ship. This is a product decision about what users should see — the
# licence question was settled by removing the third-party prose, not by this
# flag. See scripts/strip_imported_prose.py.
PUBLISH_AUTHORED_ONLY=false

# --- sizing -----------------------------------------------------------------
# Gunicorn worker processes. Roughly one per core; these are async workers
# doing mostly I/O, so the usual (2 x cores) + 1 rule does not apply.
WEB_CONCURRENCY=4

# --- rate limiting ----------------------------------------------------------
# Per client, per minute (uploads per hour). State is per process, so N API
# replicas enforce N times these numbers — see app/middleware/ratelimit.py.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_UPLOAD_PER_HOUR=30

# --- AI tutor (optional) ----------------------------------------------------
# Unreachable Ollama is a supported state: the tutor degrades to deterministic
# retrieval over the corpus rather than failing. Leave as-is if you have no GPU
# host. `host.docker.internal` reaches an Ollama running on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- logging ----------------------------------------------------------------
# JSON lines on stdout in production, for a log shipper to parse.
LOG_LEVEL=INFO
