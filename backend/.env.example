# Copy to .env and adjust. Every value below is also the built-in default
# (except SECRET_KEY, which you should always override).

# --- app ---
ENVIRONMENT=development
DEBUG=true

# --- database ---
# SQLite needs no setup. To use Postgres instead:
#   pip install psycopg2-binary
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillatlas
#   docker compose --profile postgres up -d
DATABASE_URL=sqlite:///./skillatlas.db

# --- auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI tutor (local Ollama) ---
# Requires: ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# If Ollama is unreachable the tutor degrades to deterministic retrieval.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=180

# --- AI tutor provider ---------------------------------------------------
# auto = OpenRouter when OPENROUTER_API_KEY is set, Ollama otherwise.
# Force with: ollama | openrouter | retrieval
LLM_PROVIDER=auto

# --- OpenRouter (hosted tutor; required in any deployment without a GPU) ---
# Get a key at https://openrouter.ai/keys. Never commit a real one — this file
# is tracked; the real value belongs in .env, which is not.
#
# The default model is a `:free` one. Free models are capped at 20 requests a
# minute and 50 a day on an account that has never bought credits (1000/day
# once it has). Past the cap the tutor answers from retrieval instead of
# failing, so the site stays usable — it just stops generating prose.
#
# OpenRouter brokers chat, not embeddings, so vector search is unavailable
# under this provider and retrieval falls back to BM25. The stored vectors are
# untouched and are used again as soon as an embedding-capable provider is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TIMEOUT_SEC=120
